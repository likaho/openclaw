# Build stage
FROM node:22-alpine AS builder

WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@10.23.0 --activate

# Copy package files
COPY package.json pnpm-lock.yaml ./
COPY packages/*/package.json ./packages/ 2>/dev/null || true
COPY extensions/*/package.json ./extensions/ 2>/dev/null || true

# Install dependencies
RUN pnpm install --frozen-lockfile --prod

# Copy source
COPY src/ ./src/
COPY scripts/ ./scripts/
COPY openclaw.mjs ./
COPY tsconfig.json ./
COPY tsdown.config.ts ./

# Build TypeScript
RUN pnpm build

# Production stage
FROM node:22-alpine AS production

WORKDIR /app

# Install production dependencies
RUN apk add --no-cache tini

# Copy package files for production deps
COPY package.json pnpm-lock.yaml ./
RUN corepack enable && corepack prepare pnpm@10.23.0 --activate
RUN pnpm install --frozen-lockfile --prod --ignore-scripts

# Copy built application
COPY --from=builder /app/dist ./dist/
COPY --from=builder /app/openclaw.mjs ./
COPY --from=builder /app/node_modules/.bin ./node_modules/.bin/
COPY package.json ./

# Create non-root user
RUN addgroup -g 1000 -S openclaw && \
    adduser -u 1000 -S openclaw -G openclaw

USER openclaw

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/index.js"]
